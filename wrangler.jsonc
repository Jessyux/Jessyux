{
  // Don't deploy from this branch. jessyux.com is deployed only from the whisker-isles branch, which takes in
  // accessibility-playground and adds Whisker Isles (its online rooms and leaderboard bindings live there).
  // A deploy from here would try to drop the game's rooms, and Cloudflare refuses that.
  "name": "jessyux",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.jessyux.com", "zone_name": "jessyux.com", "custom_domain": true },
    { "pattern": "jessyux.com", "zone_name": "jessyux.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The sand message wall (tables in worker/schema.sql); SAND_SALT is a secret on this Worker.
  "d1_databases": [
    { "binding": "SAND_DB", "database_name": "jessyux-sand", "database_id": "a48c2afe-8253-4b02-8ee0-5b32f25176f6" }
  ],
  // Local testing (wrangler dev --env local) uses a placeholder sand database instead of the real one.
  "env": {
    "local": {
      "d1_databases": [
        { "binding": "SAND_DB", "database_name": "jessyux-sand", "database_id": "00000000-0000-0000-0000-000000000000" }
      ]
    }
  }
}
