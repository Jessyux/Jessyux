{
  // The Whisker Isles Worker at whisker.jessyux.com. Deployed only from the whisker-isles branch:
  //   node build-game.mjs && npx --yes wrangler@4 deploy
  // The portfolio (jessyux.com) is a separate Worker deployed from accessibility-playground, so a
  // deploy from either branch never touches the other.
  "name": "whisker-isles",
  "compatibility_date": "2026-10-19",
  "main": "worker/game.mjs",
  "workers_dev": false,
  "routes": [
    { "pattern": "whisker.jessyux.com", "zone_name": "jessyux.com", "custom_domain": true }
  ],
  // the public half of the push notification key (the private half is the VAPID_PRIVATE secret)
  "vars": { "VAPID_PUBLIC": "BIGGdRx2WP4SwG2qYLJnR2Hto_hMv3uXPS5AvBgKPLZabdRVV3uth79c5H4ytyIqCfrbvOL9fNyW9myRZMvxfHU" },
  "assets": {
    "directory": "./dist-game",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // the shared leaderboard (tables in worker/whisker-schema.sql). WHISKER_SALT is a secret on this Worker.
  "d1_databases": [
    { "binding": "WHISKER_DB", "database_name": "jessyux-whisker", "database_id": "8157c43e-c010-4a1e-ab9b-b0eedef75425" }
  ],
  // online games: one room per cat code, kept in the room's own storage (worker/whisker-room.mjs)
  "durable_objects": {
    "bindings": [ { "name": "ROOMS", "class_name": "WhiskerRoom" } ]
  },
  // The rooms move here from the jessyux Worker with their saved games. The transfer creates the
  // class, so there is no new_sqlite_classes step. Tags are permanent: add new migrations after v1.
  "migrations": [
    { "tag": "v1", "transferred_classes": [ { "from": "WhiskerRoom", "from_script": "jessyux", "to": "WhiskerRoom" } ] }
  ],
  // local testing: npx --yes wrangler@4 dev --env local
  "env": {
    "local": {
      "durable_objects": { "bindings": [ { "name": "ROOMS", "class_name": "WhiskerRoom" } ] },
      "migrations": [ { "tag": "v1", "new_sqlite_classes": ["WhiskerRoom"] } ],
      "vars": { "VAPID_PUBLIC": "BIGGdRx2WP4SwG2qYLJnR2Hto_hMv3uXPS5AvBgKPLZabdRVV3uth79c5H4ytyIqCfrbvOL9fNyW9myRZMvxfHU" },
      "d1_databases": [
        { "binding": "WHISKER_DB", "database_name": "jessyux-whisker", "database_id": "8157c43e-c010-4a1e-ab9b-b0eedef75425" }
      ]
    }
  }
}
