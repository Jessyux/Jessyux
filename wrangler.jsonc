{
  "name": "jessyux",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.jessyux.com", "zone_name": "jessyux.com", "custom_domain": true },
    { "pattern": "jessyux.com", "zone_name": "jessyux.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The sand wall's database is only bound for local testing, so this file still deploys the site
  // before the real database exists: the sand screen then says messages can't be saved.
  // At deploy, with Jessy's go-ahead, add the same block at the top level with the real ID.
  "env": {
    "local": {
      "d1_databases": [
        { "binding": "SAND_DB", "database_name": "jessyux-sand", "database_id": "00000000-0000-0000-0000-000000000000" }
      ]
    }
  }
}
