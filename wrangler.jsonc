{
  "name": "jessyux",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.jessyux.com", "zone_name": "jessyux.com", "custom_domain": true },
    { "pattern": "jessyux.com", "zone_name": "jessyux.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "SAND_DB",
      "database_name": "jessyux-sand",
      // placeholder for local testing. Set at deploy, after creating the real database with Jessy's go-ahead.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
