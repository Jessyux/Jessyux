{
  // The portfolio Worker, deployed from this branch:  node build-home.mjs && node redesign-2026/build.mjs
  //                                                   npx --yes wrangler@4 deploy
  // Whisker Isles is its own Worker (whisker-isles, at whisker.jessyux.com), deployed only from the whisker-isles
  // branch. It took the online rooms (WhiskerRoom) over from this Worker with a transfer migration, so this
  // Worker has no game code or bindings. jessyux.com/whisker-isles is only a handoff page to the game's address.
  // The first deploy from here must come after the game Worker's first deploy, or Cloudflare refuses it
  // because this Worker would still own the rooms.
  "name": "jessyux",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.jessyux.com", "zone_name": "jessyux.com", "custom_domain": true },
    { "pattern": "jessyux.com", "zone_name": "jessyux.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The sand message wall (tables in worker/schema.sql); SAND_SALT is a secret on this Worker.
  "d1_databases": [
    { "binding": "SAND_DB", "database_name": "jessyux-sand", "database_id": "a48c2afe-8253-4b02-8ee0-5b32f25176f6" }
  ],
  // Local testing (wrangler dev --env local) uses a placeholder sand database instead of the real one.
  "env": {
    "local": {
      "d1_databases": [
        { "binding": "SAND_DB", "database_name": "jessyux-sand", "database_id": "00000000-0000-0000-0000-000000000000" }
      ]
    }
  }
}
