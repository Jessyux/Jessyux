{
  // Preview Worker for review on a phone: the same site and code as wrangler.jsonc, but its own
  // Worker with no custom domains, so it never touches jessyux.com. Served at
  // https://jessyux-preview.portoflio-2026.workers.dev
  // Like the live site, deploy it only from the whisker-isles branch (which takes in this branch and adds
  // Whisker Isles):  node build-home.mjs && node redesign-2026/build.mjs
  //                  npx --yes wrangler@4 deploy -c wrangler.preview.jsonc
  "name": "jessyux-preview",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // the real sand message wall (tables in worker/schema.sql; SAND_SALT is a secret on this Worker)
  "d1_databases": [
    { "binding": "SAND_DB", "database_name": "jessyux-sand", "database_id": "a48c2afe-8253-4b02-8ee0-5b32f25176f6" }
  ]
}
