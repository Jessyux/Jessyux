{
  // Preview Worker for review on a phone: the same site and code as wrangler.jsonc, but its own
  // Worker with no custom domains, so it never touches jessyux.com.
  // Cloudflare gives no preview URLs (--preview-alias) to a Worker with Durable Objects, so the
  // "playground" alias stopped updating once Whisker Isles online play arrived. This replaces it:
  //   node build-home.mjs && node redesign-2026/build.mjs
  //   npx --yes wrangler@4 deploy -c wrangler.preview.jsonc
  // and it is served at https://jessyux-preview.portoflio-2026.workers.dev
  "name": "jessyux-preview",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // the same Whisker Isles leaderboard as the live site
  "d1_databases": [
    { "binding": "WHISKER_DB", "database_name": "jessyux-whisker", "database_id": "8157c43e-c010-4a1e-ab9b-b0eedef75425" }
  ],
  // its own online game rooms, separate from the live site's
  "durable_objects": {
    "bindings": [ { "name": "ROOMS", "class_name": "WhiskerRoom" } ]
  },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["WhiskerRoom"] } ]
}
