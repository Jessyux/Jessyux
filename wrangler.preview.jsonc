{
  // Preview of the Whisker Isles Worker, for review on a phone. No custom domain, so it never
  // touches whisker.jessyux.com:
  //   node build-game.mjs && npx --yes wrangler@4 deploy -c wrangler.preview.jsonc
  // served at https://whisker-isles-preview.portoflio-2026.workers.dev
  // Its rooms move over from the old jessyux-preview Worker, as a rehearsal for the live move.
  "name": "whisker-isles-preview",
  "compatibility_date": "2026-10-19",
  "main": "worker/game.mjs",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-game",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // the same leaderboard as the live game
  "d1_databases": [
    { "binding": "WHISKER_DB", "database_name": "jessyux-whisker", "database_id": "8157c43e-c010-4a1e-ab9b-b0eedef75425" }
  ],
  "durable_objects": {
    "bindings": [ { "name": "ROOMS", "class_name": "WhiskerRoom" } ]
  },
  "migrations": [
    { "tag": "v1", "transferred_classes": [ { "from": "WhiskerRoom", "from_script": "jessyux-preview", "to": "WhiskerRoom" } ] }
  ]
}
